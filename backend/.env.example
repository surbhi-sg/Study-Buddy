# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sb_user
DB_PASSWORD=tiger
DB_NAME=studybuddy

# Required: any long random string. Login and register fail without it.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h

# Local time zone for dates and availability slots (India). Sessions are stored in UTC.
APP_TZ_OFFSET=+05:30
